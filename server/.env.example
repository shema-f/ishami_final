PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/ishami
MONGODB_DB=ishami
JWT_SECRET=change-this-in-production

# ============================================================
# Moto-Sensei AI — Rwanda Traffic Rules Assistant
# Provider priority: AI_PROVIDER=auto -> Ollama avail -> Gemini key -> Groq key
# ============================================================

# auto | ollama | gemini | groq
AI_PROVIDER=auto

# --- Ollama (self-hosted, recommended for privacy + Rwanda traffic data accuracy)
# Install Ollama from https://ollama.ai  then:  ollama pull deepseek-r1:8b
# If OLLAMA_MODEL is not pulled locally, Moto-Sensei auto-falls back to any
# available deepseek/qwen/llama model instead of failing.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=deepseek-r1:8b

# --- Google Gemini (fallback when Ollama unavailable)
# Get key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- Groq (high throughput fallback)
# Get key: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Hardware-aware pipeline
AI_TIMEOUT_MS=120000
AI_MAX_CONCURRENCY=2
AI_MAX_CONTEXT_CHARS=6000
AI_RAG_TOP_K=5

# Web search augmentation (for questions the offline KB can't answer, e.g. fines/penalties)
# Providers: serper (https://serper.dev, free tier) | exa (https://dashboard.exa.ai) | brave (https://api.search.brave.com)
SEARCH_PROVIDER=serper
SERPER_API_KEY=
EXA_API_KEY=
BRAVE_API_KEY=

# MTN MoMo Collections
MOMO_SUBSCRIPTION_KEY=9gHHXXXXXXXXXXXXXXXXXXXXXXXXbfiT
MOMO_API_USER=YOUR_API_USER_UUID
MOMO_API_KEY=LEnRXXXXXXXXUSCn
MOMO_ENV=sandbox
MOMO_BASE_URL=https://proxy.momoapi.mtn.com/collection/v1_0
MOMO_CALLBACK_URL=http://localhost:5000/api/webhook/mtn

# Optional email settings
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="ISHAMI <no-reply@ishami.rw>"

# Admin seeding
ADMIN_EMAIL=admin@ishami.rw
ADMIN_PASSWORD=admin123
